# CineGraph — copy to .env and fill what you have.
# The platform runs in MOCK mode without keys. Real Gemini/ClickHouse/Grafana light up when set.

# google-ai-studio or Vertex
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GENERATION_BACKEND=auto
# auto | mock | gemini | replicate
REPLICATE_API_TOKEN=

# ClickHouse Cloud or local docker (default: local)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinegraph

# OpenTelemetry → Grafana Cloud Tempo / local Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cinegraph

# Localization
LOCALIZATION_SOURCE_LANG=en
LOCALIZATION_TARGET_LANG=hi

CINEGRAPH_DATA_DIR=./data
CINEGRAPH_HOST=0.0.0.0
CINEGRAPH_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SKIP_TTS=false
